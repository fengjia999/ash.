# Required gateway credentials. Use different, randomly generated values.
API_KEY=
GATEWAY_SECRET=
DASHBOARD_PASSWORD=

# Model routing
DEFAULT_MODEL=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ROUTE_PROVIDER=auto

# Persistent conversations and memory
DATABASE_URL=postgresql://user:password@localhost:5432/ash
MEMORY_ENABLED=true
CONTEXT_MANAGED=true
TIMEZONE_HOURS=8

# Optional MCP servers. Never commit real bearer tokens.
# MCP_SERVERS_JSON=[{"url":"https://example.com/mcp","bearer_token":"replace-me"}]

# Link shown in the Dashboard. Override it when publishing your own fork.
PUBLIC_REPOSITORY_URL=https://github.com/fengjia999/Ash-public
