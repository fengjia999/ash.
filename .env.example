# Dashboard and gateway authentication. Use different random values.
DASHBOARD_PASSWORD=
GATEWAY_SECRET=
MCP_SECRET=
DASHBOARD_COOKIE_SECURE=true

# Model routing. Set the credentials for the route you use.
ROUTE_PROVIDER=auto
DEFAULT_MODEL=
API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# PostgreSQL is required for startup and persistent conversations.
DATABASE_URL=
MEMORY_ENABLED=true
CONTEXT_MANAGED=true
TIMEZONE_HOURS=8
PORT=8000

# Optional MCP servers. Never commit real bearer tokens.
# MCP_SERVERS_JSON=[{"url":"https://example.com/mcp","bearer_token":"replace-me"}]
